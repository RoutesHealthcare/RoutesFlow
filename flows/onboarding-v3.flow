key "What the lines mean" @ 20,420

applicant -> staging [route=elbow]
staging -> update_api [route=elbow]
staging -> run_checks [route=elbow]
run_checks -> queue [route=elbow]
queue -> applicant_page [route=elbow] : "Review"
applicant_page -> checks_pass [route=elbow]
checks_pass -> create [route=elbow] : "Yes"
checks_pass -alt-> fix_fountain [route=elbow] : "No"
fix_fountain -alt-> recheck [route=elbow]
recheck -alt-> run_checks [route=elbow]
applicant_page -data-> audit [route=elbow]
create -data-> audit [route=elbow] : "Every create and check is logged"
create -> lumis [route=elbow]
lumis -data-> lumis_id [route=elbow]
lumis -data-> staging [route=elbow] : "LumisID written back"
create -> id_badge [route=elbow]   # As v2: approval leads to an ID badge request
create -> staff_group [route=elbow]   # The approval screen shows only the systems the staff group needs
staff_group -> selecthr [route=elbow] : "Office"
staff_group -> pp [route=elbow] : "Care"
selecthr -> dse [route=elbow]   # Inferred: the wireframe offers the DSE user to all office staff; the order after SelectHR is assumed
selecthr -> exchange [route=elbow]   # Inferred: v2 set up MS Exchange before SelectHR; in v3 SelectHR is created first, from the approval screen
exchange -> is_temp [route=elbow]
is_temp -> evo [route=elbow] : "No: automation · Yes: manual creation"
evo -> pp_acp [route=elbow]
pp_acp -> pp_modules [route=elbow]
pp_modules -> acp_profile [route=elbow]
acp_profile -> role_products [route=elbow]
role_products .. lm_note [route=elbow]
role_products -> temp_perm [route=elbow]
temp_perm -> deactivate [route=elbow] : "Yes"
deactivate -alt-> selecthr [route=elbow] : "Re-create as permanent"
temp_perm -> end [route=elbow] : "No"
dse -> dse_assign [route=elbow]
dse_assign -> admin_needed [route=elbow]   # As v2: the assignment step leads to the manager-role check
admin_needed -> admin [route=elbow] : "Yes"
admin_needed -> end [route=elbow] : "No"
admin -> admin_perms [route=elbow]
admin_perms -> is_supervisory [route=elbow]
is_supervisory -> staff_to_mgr [route=elbow] : "Yes"
is_supervisory -> end [route=elbow] : "No"
staff_to_mgr -> end [route=elbow]
pp -alt-> pp_alert [route=elbow] : "Fails validation"
pp_alert -alt-> fix_fountain [route=elbow]
pp -> onboarding_tasks [route=elbow]
onboarding_tasks -> pp_portal [route=elbow]
pp_portal -> is_driver [route=elbow]
is_driver -> mileage [route=elbow] : "Yes"
is_driver -> acp_integration [route=elbow] : "No"
mileage -> acp_integration [route=elbow]
acp_integration -> device [route=elbow]
device -> end [route=elbow]

