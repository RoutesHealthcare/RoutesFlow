approver -> s_queue [route=elbow]
s_queue <-> s_created [route=elbow] : "Tab"
s_created <-> s_audit [route=elbow] : "Tab"
s_queue .. f_search [route=elbow]
s_queue .. f_hub [route=elbow]
s_queue .. f_filter [route=elbow]
s_queue <-> s_office [route=elbow] : "Review / back"
s_queue <-> s_care [route=elbow] : "Review / back"
s_office .. b_recheck [route=elbow]
s_care .. b_recheck [route=elbow]
s_office .. b_lumis [route=elbow]
s_office .. b_selecthr [route=elbow]
s_office .. b_dse [route=elbow]
s_office .. b_admin [route=elbow]
s_care .. b_lumis_c [route=elbow]
s_care .. b_pp [route=elbow]

page "UI layer: field checks" size 594x420 direction LR

c_title: text "Which Fountain fields each system needs" @ 20,16 200x10 [text=#FA4616 size=14]
fountain_rec: database "Fountain applicant record (via data staging table)" @ 20,136 48x26 [size=9]
t_lumis: table "Lumis – all staff" { First name; Last name; Email; Role (Fountain funnel); Hub / location; Start date; Lumis username (must be free) } @ 150,40
t_selecthr: table "SelectHR – office staff" { Title; First name; Last name; Date of birth; National Insurance number; Email; Phone; Address lines 1–3 (3 optional); Postcode; Hub / location; Start date; SelectHR post ID; DBS update service; Next of kin name / number / relationship; Equality monitoring: present or not } @ 150,120
t_dse: table "DSE Portal – office staff" { First name; Last name; Email; Hub / location } @ 300,40
t_admin: table "Admin Portal – managers, hub staff, trainers, quote creators" { First name; Last name; Email; Role (Fountain funnel); Hub / location; Admin access type (chosen by approver) } @ 300,120
t_pp: table "People Planner – rostered care staff" { First name; Last name; Date of birth; Email; Phone; Postcode; Role (Fountain funnel); Hub / location; Start date } @ 450,40
fountain_rec -data-> t_lumis [route=elbow]
fountain_rec -data-> t_selecthr [route=elbow]
fountain_rec -data-> t_dse [route=elbow]
fountain_rec -data-> t_admin [route=elbow]
fountain_rec -data-> t_pp [route=elbow]
n_gender: text "Gender is recorded in Fountain but not currently sent to SelectHR (queried). Equality values are never shown, only whether each is present." @ 317,238 120x14 [size=8]
n_pp: text "To confirm: the People Planner field list against validate_applicant_row() in pp_fountain_applicant.py. Fields marked DSE and Admin Portal are inferred from the wireframe, which lists them only as \"All systems\"." @ 317,265 150x18 [size=8]
