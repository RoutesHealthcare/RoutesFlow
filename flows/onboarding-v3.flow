evo: subprocess "Access EVO profile" @ 660,154 40x20 [size=9]
pp_acp: process "PP/ACP permissions" @ 660,194 40x20 [size=9]
pp_modules: process "Assign PP modules and functions, branch view" @ 660,234 40x20 [size=9]
acp_profile: process "Assign ACP profile, branch, groups etc" @ 660,274 40x20 [size=9]
role_products: decision "Role-related products?" @ 596,274 40x24 [size=9]
lm_note: text "Line manager decides PowerBI, Claude etc" @ 596,306 40x10 [size=8]
